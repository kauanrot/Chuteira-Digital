// Modelo de dados (PostgreSQL). Usado pelos repositorios Prisma em
// src/repositories/prisma (ativados quando DATABASE_URL esta definida).
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Perfil {
  ADMIN
  PROFESSOR
  RESPONSAVEL
}

// Conta de acesso ao sistema. A senha nunca e gravada: apenas o hash bcrypt.
model Usuario {
  id        Int      @id @default(autoincrement())
  nome      String
  email     String   @unique
  senhaHash String
  perfil    Perfil
  criadoEm  DateTime @default(now())
  turmas    Turma[]
  alunos    Aluno[]
}

model Aluno {
  id                   Int         @id @default(autoincrement())
  nome                 String
  dataNascimento       DateTime    @db.Date
  responsavel          String?
  telefone             String?
  email                String?
  // Conta (perfil RESPONSAVEL) que pode acompanhar este aluno.
  responsavelUsuarioId Int?
  responsavelUsuario   Usuario?    @relation(fields: [responsavelUsuarioId], references: [id], onDelete: SetNull)
  matriculas           Matricula[]
  presencas            Presenca[]
}

model Turma {
  id          Int         @id @default(autoincrement())
  nome        String
  categoria   String
  local       String?
  vagas       Int
  // Conta (perfil PROFESSOR) responsavel pela turma.
  professorId Int?
  professor   Usuario?    @relation(fields: [professorId], references: [id], onDelete: SetNull)
  matriculas  Matricula[]
  chamadas    Chamada[]
}

model Matricula {
  alunoId Int
  turmaId Int
  aluno   Aluno @relation(fields: [alunoId], references: [id])
  turma   Turma @relation(fields: [turmaId], references: [id])

  @@id([alunoId, turmaId])
}

model Chamada {
  id        Int        @id @default(autoincrement())
  turmaId   Int
  data      DateTime   @db.Date
  turma     Turma      @relation(fields: [turmaId], references: [id])
  presencas Presenca[]

  @@unique([turmaId, data])
}

model Presenca {
  chamadaId Int
  alunoId   Int
  presente  Boolean
  chamada   Chamada @relation(fields: [chamadaId], references: [id])
  aluno     Aluno   @relation(fields: [alunoId], references: [id])

  @@id([chamadaId, alunoId])
}
