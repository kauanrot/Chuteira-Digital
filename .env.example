# Copie para .env e ajuste. Sem DATABASE_URL a API usa repositorios em memoria.

# --- API rodando na maquina (npm start) ---
# Aponta para o banco do Docker (docker compose up -d db), exposto na porta 5433.
DATABASE_URL="postgresql://chuteira:chuteira@localhost:5433/chuteira_digital?schema=public"
PORT=3000

# --- Login (JWT + bcrypt) ---
# Segredo que assina os tokens. Gere um valor longo e aleatorio, por exemplo:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Obrigatorio em producao (NODE_ENV=production).
JWT_SECRET="troque-por-um-valor-longo-e-aleatorio"
# Administrador criado automaticamente na primeira vez que a API sobe sem usuarios.
ADMIN_NOME="Secretaria"
ADMIN_EMAIL="admin@chuteira.local"
ADMIN_SENHA="troque-esta-senha"

# Opcional: banco SEPARADO para rodar os testes contra o PostgreSQL (npm run test:db).
# ATENCAO: os testes apagam todos os dados desse banco.
# TEST_DATABASE_URL="postgresql://chuteira:chuteira@localhost:5433/chuteira_digital_test?schema=public"

# --- docker-compose.yml (opcional; estes sao os valores padrao) ---
# Se trocar usuario/senha/banco aqui, ajuste tambem a DATABASE_URL acima.
# POSTGRES_USER=chuteira
# POSTGRES_PASSWORD=chuteira
# POSTGRES_DB=chuteira_digital
# DB_PORT=5433
# API_PORT=3000
# WEB_PORT=80
