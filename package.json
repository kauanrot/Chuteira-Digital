{
  "name": "chuteira-digital",
  "version": "1.0.0",
  "description": "Chuteira Digital - Sistema de gestao para escola de futebol (Projeto Laboratorio de Engenharia de Software - Mackenzie)",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "test": "jest --coverage",
    "test:db": "jest --runInBand",
    "postinstall": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio"
  },
  "keywords": [
    "chuteira-digital",
    "escola-de-futebol"
  ],
  "author": "Kauan Rotondaro Dias Alves, Gabriel Medina Peres, Kaiki Bellini Barbosa",
  "license": "ISC",
  "devDependencies": {
    "jest": "^29.7.0",
    "supertest": "^7.0.0"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "cors": "^2.8.5",
    "dotenv": "^18.0.9",
    "express": "^4.19.2",
    "prisma": "^6.19.3"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/*.test.js"
    ],
    "coveragePathIgnorePatterns": [
      "/node_modules/",
      "src/index.js",
      "tests/helpers/"
    ]
  }
}
